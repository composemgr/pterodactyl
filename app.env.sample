# Pterodactyl Panel — environment variable reference
# Copy this file to app.env and adjust as needed.

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=pterodactyl.example.com
BASE_DOMAIN_NAME=example.com

# Application encryption key, generated with
# php artisan key:generate --show
APP_ENCRYPTION_KEY=replace-with-a-random-base64-key

# Database
DB_CREATE_DATABASE_NAME=pterodactyl
DB_USER_NAME=pterodactyl
DB_USER_PASS=replace-with-a-random-password
DB_ADMIN_PASS=replace-with-a-random-password
